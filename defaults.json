  ]},
  {"id":"icmp-controls","name":"ICMP controls","description":"Endpoint data only unless the selected path supplies a qualified ICMP capability.","targets":[
    {"name":"CF DNS","host":"1.1.1.1","role":"ICMP control","probes":["icmp"]},
    {"name":"Google DNS","host":"8.8.8.8","role":"ICMP control","probes":["icmp"]}
